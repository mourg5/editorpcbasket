<UserControl x:Class="Editor_PCBasket___Mou.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource MaterialDesign.Brush.Badged.LightBackground}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <GroupBox Margin="16" Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Basketball" Width="32" Height="32" VerticalAlignment="Center"/>
                                <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                                   Text="Instalación PC Basket" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox MinWidth="700"  Text="{Binding PcbPath}" materialDesign:HintAssist.Hint="Ruta de instalación" IsHitTestVisible="False" VerticalAlignment="Center" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                            <Button Content="Seleccionar" Command="{Binding SelectPathCommand}" Margin="5,0"/>
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Content="MANAGER.EXE" />
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="15,0">
                                <Button IsHitTestVisible="False" Width="24" Height="24" Padding="0" Visibility="{Binding IconsVisibility}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ManagerOk}" Value="True">
                                                    <Setter Property="Background" Value="LimeGreen"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ManagerOk}" Value="False">
                                                    <Setter Property="Background" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Height="18" Width="18" Margin="0" Padding="0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ManagerOk}" Value="True">
                                                        <Setter Property="Kind" Value="CheckBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ManagerOk}" Value="False">
                                                        <Setter Property="Kind" Value="CloseThick" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                                <Label Content="{Binding ManagerStatus}" FontWeight="Light"/>
                            </StackPanel>

                            <Label Content="DBDAT" Grid.Row="1"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="15,0">
                                <Button IsHitTestVisible="False" Width="24" Height="24" Padding="0" Visibility="{Binding IconsVisibility}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Eq22Ok}" Value="True">
                                                    <Setter Property="Background" Value="LimeGreen"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Eq22Ok}" Value="False">
                                                    <Setter Property="Background" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Height="18" Width="18" Margin="0" Padding="0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Eq22Ok}" Value="True">
                                                        <Setter Property="Kind" Value="CheckBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Eq22Ok}" Value="False">
                                                        <Setter Property="Kind" Value="CloseThick" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                                <Label Content="{Binding Eq22Status}"  FontWeight="Light"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="15,0">
                                <Button IsHitTestVisible="False" Width="24" Height="24" Padding="0" Visibility="{Binding IconsVisibility}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DbcOk}" Value="True">
                                                    <Setter Property="Background" Value="LimeGreen"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DbcOk}" Value="False">
                                                    <Setter Property="Background" Value="Orange"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Height="18" Width="18" Margin="0" Padding="0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DbcOk}" Value="True">
                                                        <Setter Property="Kind" Value="CheckBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DbcOk}" Value="False">
                                                        <Setter Property="Kind" Value="FileRemoveOutline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                                <Label Content="{Binding DbcStatus}"  FontWeight="Light"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="16" Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Database" Width="32" Height="32" VerticalAlignment="Center"/>
                                <TextBlock Margin="8,0,0,0" 
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}" 
                                       Text="Base de datos" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="BBDD" />
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="15,0">
                            <materialDesign:PackIcon Kind="CheckBold" Foreground="LimeGreen" VerticalAlignment="Center" Height="20" Width="20" Margin="0" Padding="0" />
                            <Label Content="Activa" FontWeight="Light"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="15,0">
                            <materialDesign:PackIcon Kind="PoliceBadgeOutline" VerticalAlignment="Center" Foreground="{DynamicResource AccentColorBrush}" Height="20" Width="20" Margin="0" Padding="0" />
                            <Label Content="{Binding TeamsStatus}" FontWeight="Light"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="15,0">
                            <materialDesign:PackIcon Kind="AccountGroup" VerticalAlignment="Center" Foreground="{DynamicResource AccentColorBrush}" Height="20" Width="20" Margin="0" Padding="0" />
                            <Label Content="{Binding PlayersStatus}" FontWeight="Light"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                            <Button Content="Importar BBDD" Command="{Binding GenerateDbCommand}" Margin="5" Width="300" />
                            <Button Content="Vaciar BBDD" Command="{Binding CreateEmptyDbCommand}" Margin="5" Width="300" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Margin="16" Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Export" Width="32" Height="32" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                                   Text="Exportación de datos" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <CheckBox Content="Exportar países con ficha Europea como no extranjeros" Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}" IsChecked="{Binding UseEurNationality}" />
                        <CheckBox Content="Exportar países con ficha Cotonou como no extranjeros" Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}" IsChecked="{Binding UseCotNationality}"/>
                        <CheckBox Content="Ajustar fechas de nacimiento a la temporada del MANAGER.EXE" Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}" IsChecked="{Binding AdjustBirthDates}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Aceptar" Command="{Binding AcceptCommand}" Margin="5,0" Width="200" />
                <Button Content="Cancelar" Command="{Binding CancelCommand}" Foreground="{DynamicResource AccentColorBrush}" Style="{StaticResource MaterialDesignOutlinedLightButton}" Margin="5,0" Width="200" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
