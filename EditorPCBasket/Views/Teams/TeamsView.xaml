<UserControl x:Class="Editor_PCBasket___Mou.Views.Teams.TeamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{DynamicResource MaterialDesign.Brush.Badged.LightBackground}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Margin="16" Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tools" Width="32" Height="32" VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}" 
                                   Text="Herramientas" />
                    </StackPanel>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
        </GroupBox>

        <GroupBox Margin="16" Style="{StaticResource MaterialDesignCardGroupBox}" Grid.Row="1">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FormatListBulletedType" Width="32" Height="32" VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                   Text="Lista de equipos" />
                    </StackPanel>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <DataGrid ItemsSource="{Binding TeamsList}" Name="EquiposDataGrid" 
                      Margin="5"
                      ScrollViewer.CanContentScroll="True" 
                      AutoGenerateColumns="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      IsReadOnly="True">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Punt." Binding="{Binding Puntero}" Width="60"/>
                    <DataGridTextColumn Header="Nombre Corto" Binding="{Binding NombreCorto}" />
                    <DataGridTextColumn Header="Nombre Largo" Binding="{Binding NombreLargo}" />
                    <DataGridTextColumn Header="Media (Q)" Binding="{Binding MediaQuinteto}" />
                    <DataGridTextColumn Header="Media (P)" Binding="{Binding MediaPlantilla}" />
                    <DataGridTemplateColumn Width="SizeToCells" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Width="14" Height="10" Source="{Binding Pais, Converter={StaticResource PaisToBanderaConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Pais" Binding="{Binding Pais}" />
                    <DataGridTextColumn Header="Pabellon" Binding="{Binding Pabellon}" />
                    <DataGridTextColumn Header="Aforo" Binding="{Binding Aforo}" />
                    <DataGridTextColumn Header="Presupuesto" Binding="{Binding Presupuesto}" />
                    <DataGridTextColumn Header="Entrenador" Binding="{Binding Entrenador}" />
                    <DataGridComboBoxColumn Width="0" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
