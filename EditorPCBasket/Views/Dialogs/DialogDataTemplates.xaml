                    xmlns:vm="clr-namespace:Editor_PCBasket___Mou.ViewModels.Dialogs">
    <DataTemplate DataType="{x:Type vm:SimpleDialogViewModel}">
        <local:SimpleDialog/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:InputDialogViewModel}">
