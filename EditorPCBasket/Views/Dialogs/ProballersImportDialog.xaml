<UserControl x:Class="Editor_PCBasket___Mou.Views.Dialogs.ProballersImportDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Editor_PCBasket___Mou.Views.Dialogs">
    <Grid Margin="20" MaxWidth="800">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" 
                  Margin="0,0,0,5"
                  FontSize="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}" 
                  HorizontalAlignment="Center"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="{Binding Icon}" 
                                Margin="0,0,10,0"
                                VerticalAlignment="Center" 
                                Width="{Binding IconSize}" Height="{Binding IconSize}" 
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}" />
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBox Margin="5" materialDesign:HintAssist.Hint="Url"  Width="600"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                 HorizontalAlignment="Left"
                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Margin="5" materialDesign:HintAssist.Hint="Puntero equipo" VerticalAlignment="Center" Width="150"                                 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 HorizontalAlignment="Left"
                                 PreviewTextInput="NumberValidationTextBox"
                                 Text="{Binding TeamPointer, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Margin="5" materialDesign:HintAssist.Hint="Punt. primer jugador" VerticalAlignment="Center" Width="150"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 HorizontalAlignment="Left"
                                 PreviewTextInput="NumberValidationTextBox"
                                 Text="{Binding PlayerPointer, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Generar escudos" Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}" IsChecked="{Binding GenerateBadges}" />
                        <CheckBox Content="Generar fotos" Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}" IsChecked="{Binding GeneratePhotos}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBox Margin="5" materialDesign:HintAssist.Hint="Media deseada" VerticalAlignment="Center" Width="110"
                             IsEnabled="{Binding GenerateRatings}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             HorizontalAlignment="Left"
                             PreviewTextInput="NumberValidationTextBox"
                             Text="{Binding DesiredRating}"/>
                    <CheckBox Content="Generar media automática" Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}" IsChecked="{Binding GenerateRatings}" />
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button 
               Content="{Binding ButtonText}"
               HorizontalAlignment="Right"
               Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
               IsDefault="True"
               Style="{StaticResource MaterialDesignFlatButton}" />
            <Button 
               Content="{Binding SecondButtonText}"
               HorizontalAlignment="Right"
               Command="{Binding AcceptCommand}"
               IsDefault="True"
               Style="{StaticResource MaterialDesignFlatButton}" />
        </StackPanel>
    </Grid>
</UserControl>
