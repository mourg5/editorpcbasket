<Window x:Class="Editor_PCBasket___Mou.MainWindow"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:prism="http://prismlibrary.com/" 
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"                
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Text.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium" TextElement.FontSize="14"
        Style="{StaticResource MaterialDesignWindow}"
        MouseDown="Window_MouseDown"
        BorderThickness="1" WindowState="Normal" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Title="Editor PC Basket - Mou" Height="800" Width="1300">
    <materialDesign:DialogHost x:Name="RootDialog" Identifier="RootDialog" DialogTheme="Inherit">
        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" BorderThickness="3">
            <DockPanel>
                <!-- App superior -->
                <materialDesign:ColorZone materialDesign:ElevationAssist.Elevation="Dp4" Padding="5" DockPanel.Dock="Top" Mode="PrimaryMid" MouseDown="ColorZone_MouseDown" MouseDoubleClick="ColorZone_MouseDoubleClick">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="24,0,0,0"
                                materialDesign:RippleAssist.Feedback="{Binding RelativeSource={RelativeSource Self}, Path=Foreground, Converter={StaticResource BrushRoundConverter}}"
                                Click="GoBackButtonClick"
                                Content="{materialDesign:PackIcon Kind=ArrowLeft, Size=24}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="Atrás" />
                            <Button Margin="16,0,0,0"
                                materialDesign:RippleAssist.Feedback="{Binding RelativeSource={RelativeSource Self}, Path=Foreground, Converter={StaticResource BrushRoundConverter}}"
                                Click="GoForwardButtonClick"
                                Content="{materialDesign:PackIcon Kind=ArrowRight,Size=24}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="Siguiente" />
                            <Button Margin="16,0,0,0"
                                materialDesign:RippleAssist.Feedback="{Binding RelativeSource={RelativeSource Self}, Path=Foreground, Converter={StaticResource BrushRoundConverter}}"
                                Click="GoHomeButtonClick"
                                Content="{materialDesign:PackIcon Kind=Home, Size=24}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="Inicio" />
                        </StackPanel>

                        <TextBlock HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                               FontSize="18"
                               Margin="20,0" 
                               Text="Editor PC Basket - Mou"/>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Content="{materialDesign:PackIcon WindowMinimize}"
                                Click="MinimizeClick"
                                Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                                Style="{StaticResource MaterialDesignFlatLightButton}"
                                ToolTip="Minimizar" />
                            <Button Content="{materialDesign:PackIcon WindowMaximize}"
                                Click="MaximizeClick"
                                Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                                Style="{StaticResource MaterialDesignFlatLightButton}"
                                ToolTip="Maximizar" />
                            <Button Content="{materialDesign:PackIcon WindowClose}"
                                Click="CloseClick"
                                Foreground="{DynamicResource MaterialDesign.Brush.Badged.DarkForeground}"
                                Style="{StaticResource MaterialDesignFlatLightButton}"
                                ToolTip="Cerrar" />
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.2*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="1" VerticalAlignment="Top" Margin="0,25">
                    </Viewbox>

                    <StackPanel Grid.Column="1" Margin="50" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <Image Source="Resources/logo.png" />
                        <Label Content="Editor creado por Mou" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" FontSize="24" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <ContentControl x:Name="MainRegion" prism:RegionManager.RegionName="MainRegion" 
                            Grid.ColumnSpan="3" Grid.Column="0" HorizontalAlignment="Stretch" />

                    <Grid Grid.Column="0" Grid.ColumnSpan="3" Height="20" VerticalAlignment="Bottom" Background="{DynamicResource MaterialDesign.Brush.Primary}">

                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </materialDesign:DialogHost>
</Window>
